# PostgreSQL ulanish manzili
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dibocomputers?schema=public"

# BotFather'dan olingan bot tokeni
BOT_TOKEN="0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Mini App joylashgan HTTPS manzil (masalan ngrok yoki Vercel linki)
MINIAPP_URL="https://your-miniapp-domain.example"

# Backend server porti
PORT=5000

# Admin panel uchun login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Telegram orqali avtomatik admin sifatida aniqlanadigan foydalanuvchi ID'lari (vergul bilan ajratilgan)
ADMIN_TELEGRAM_IDS="123456789"

# Admin JWT token sirini imzolash uchun kalit
JWT_SECRET="dibocomputers_super_secret_key_change_me"
